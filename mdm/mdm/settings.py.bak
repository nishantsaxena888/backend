"""
Django settings for mdm project (corrected).
- Loads .env from project root (D:/project/nishify/.env)
- Avoids duplicate BASE_DIR assignment and duplicate cloudinary entries
- Enables cloudinary only if CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET exist
"""

import os
import sys
from pathlib import Path
from urllib import parse as urlparse
from dotenv import load_dotenv

# -------------------------
# BASE DIR / .env loading
# -------------------------
# BASE_DIR points to mdm/mdm directory (this file's parent.parent)
BASE_DIR = Path(__file__).resolve().parent.parent

# Project root (one level up from mdm): D:/project/nishify/mdm --> project root D:/project/nishify
PROJECT_ROOT = BASE_DIR.parent

# Load .env from project root (D:/project/nishify/.env)
ENV_PATH = PROJECT_ROOT / ".env"
if ENV_PATH.exists():
    load_dotenv(ENV_PATH)
else:
    # fallback: try a top-level .env (in case mdm sits directly in project root)
    load_dotenv()

# Add project root to PYTHONPATH so imports like `backend.utils.db` work consistently
sys.path.insert(0, str(PROJECT_ROOT))

# -------------------------
# SECRET / DEBUG / HOSTS
# -------------------------
SECRET_KEY = os.environ.get("DJANGO_SECRET_KEY", "django-insecure-default-for-dev-only")
DEBUG = os.environ.get("DEBUG", "True").lower() in ("1", "true", "yes")
ALLOWED_HOSTS = os.environ.get("ALLOWED_HOSTS", "127.0.0.1,localhost").split(",")

# -------------------------
# Apps
# -------------------------
INSTALLED_APPS = [
    "scrapper",
    "django.contrib.admin",
    "django.contrib.auth",
    "django.contrib.contenttypes",
    "django.contrib.sessions",
    "django.contrib.messages",
    "django.contrib.staticfiles",
    "rest_framework",
    "corsheaders",
]

# Note: cloudinary apps will be appended conditionally below if env vars are present

# -------------------------
# Middleware / URL conf / templates
# -------------------------
MIDDLEWARE = [
    "corsheaders.middleware.CorsMiddleware",
    "django.middleware.security.SecurityMiddleware",
    "django.contrib.sessions.middleware.SessionMiddleware",
    "django.middleware.common.CommonMiddleware",
    "django.middleware.csrf.CsrfViewMiddleware",
    "django.contrib.auth.middleware.AuthenticationMiddleware",
    "django.contrib.messages.middleware.MessageMiddleware",
    "django.middleware.clickjacking.XFrameOptionsMiddleware",
]

ROOT_URLCONF = "mdm.urls"

TEMPLATES = [
    {
        "BACKEND": "django.template.backends.django.DjangoTemplates",
        "DIRS": [],
        "APP_DIRS": True,
        "OPTIONS": {
            "context_processors": [
                "django.template.context_processors.request",
                "django.contrib.auth.context_processors.auth",
                "django.contrib.messages.context_processors.messages",
            ],
        },
    },
]

WSGI_APPLICATION = "mdm.wsgi.application"

# -------------------------
# DATABASE
# -------------------------
# You used `from backend.utils.db import DATABASE_URL` in the old file.
# If you still have that helper, keep it; else fall back to DATABASE_URL env var.
try:
    from backend.utils.db import DATABASE_URL  # keep your existing loader
except Exception:
    DATABASE_URL = os.environ.get("DATABASE_URL", "")

if DATABASE_URL:
    parsed = urlparse.urlparse(DATABASE_URL)
    DATABASES = {
        "default": {
            "ENGINE": "django.db.backends.postgresql",
            "NAME": parsed.path.lstrip("/"),
            "USER": parsed.username,
            "PASSWORD": parsed.password,
            "HOST": parsed.hostname,
            "PORT": parsed.port,
        }
    }
else:
    # Minimal fallback for local dev (sqlite)
    DATABASES = {
        "default": {
            "ENGINE": "django.db.backends.sqlite3",
            "NAME": str(BASE_DIR / "db.sqlite3"),
        }
    }

# -------------------------
# Auth / i18n / timezone
# -------------------------
AUTH_PASSWORD_VALIDATORS = [
    {"NAME": "django.contrib.auth.password_validation.UserAttributeSimilarityValidator"},
    {"NAME": "django.contrib.auth.password_validation.MinimumLengthValidator"},
    {"NAME": "django.contrib.auth.password_validation.CommonPasswordValidator"},
    {"NAME": "django.contrib.auth.password_validation.NumericPasswordValidator"},
]

LANGUAGE_CODE = "en-us"
TIME_ZONE = os.environ.get("TIME_ZONE", "UTC")
USE_I18N = True
USE_TZ = True
DEFAULT_AUTO_FIELD = "django.db.models.BigAutoField"

# -------------------------
# Static files
# -------------------------
STATIC_URL = "/static/"
STATIC_ROOT = os.path.join(BASE_DIR, "staticfiles")
STATICFILES_DIRS = [os.path.join(BASE_DIR, "static")]

# -------------------------
# Media + Cloudinary (conditionally enabled)
# -------------------------
SITE_BASE_URL = os.environ.get("SITE_BASE_URL", "http://localhost:8000").rstrip("/")

# Default MEDIA_URL used by your code
MEDIA_URL = os.environ.get("MEDIA_URL", "/doc/pioneer_fresh/")

if os.environ.get("DYNO"):  # Running on Heroku
    MEDIA_ROOT = "/app/uploads/pioneer_fresh"
else:
    MEDIA_ROOT = os.environ.get("MEDIA_ROOT", str(PROJECT_ROOT / "uploads" / "pioneer_fresh"))

# Cloudinary envs
CLOUDINARY_CLOUD_NAME = os.environ.get("CLOUDINARY_CLOUD_NAME", "")
CLOUDINARY_API_KEY = os.environ.get("CLOUDINARY_API_KEY", "")
CLOUDINARY_API_SECRET = os.environ.get("CLOUDINARY_API_SECRET", "")

# Only enable cloudinary apps + settings when all three variables are present
if CLOUDINARY_CLOUD_NAME and CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET:
    INSTALLED_APPS += ["cloudinary", "cloudinary_storage"]
    DEFAULT_FILE_STORAGE = "cloudinary_storage.storage.MediaCloudinaryStorage"
    CLOUDINARY_STORAGE = {
        "CLOUD_NAME": CLOUDINARY_CLOUD_NAME,
        "API_KEY": CLOUDINARY_API_KEY,
        "API_SECRET": CLOUDINARY_API_SECRET,
    }
else:
    # Local filesystem fallback storage (default)
    DEFAULT_FILE_STORAGE = "django.core.files.storage.FileSystemStorage"

# -------------------------
# REST FRAMEWORK + CORS
# -------------------------
REST_FRAMEWORK = {
    "DEFAULT_PAGINATION_CLASS": "rest_framework.pagination.PageNumberPagination",
    "PAGE_SIZE": 25,
}

CORS_ALLOWED_ORIGINS = [
    "http://127.0.0.1:8000",
    "http://localhost:8000",
    "http://127.0.0.1:3000",
    "http://localhost:3000",
]
CORS_ALLOW_ALL_ORIGINS = True  # Dev only

